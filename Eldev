; -*- mode: emacs-lisp; lexical-binding: t -*-

(eldev-require-version "1.11")

(eldev-use-package-archive 'gnu-elpa)
(eldev-use-package-archive 'nongnu-elpa)
(eldev-use-package-archive 'melpa)

(eldev-use-plugin 'autoloads)

(eldev-add-extra-dependencies 'test 'buttercup)
(eldev-add-loading-roots 'test "test")

;; configuration for the default linters
(setq byte-compile-docstring-max-column 120)
(setq checkdoc-force-docstrings-flag nil)
(setq checkdoc-permit-comma-termination-flag t)
(setq checkdoc--interactive-docstring-flag nil)

;; curry-mode hooks into `compile' and into optional third-party packages
;; (dape, treesit-fold) with `with-eval-after-load'.  package-lint warns
;; on every use of it in a package; the rest of its checks are worth
;; keeping, so silence just that one.
(advice-add 'package-lint--check-eval-after-load :override #'ignore)

(setq eldev-project-main-file "curry-mode.el")
